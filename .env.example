# BiblioGest - Variáveis de Ambiente
# Copie para .env e preencha com os seus dados.

# ============================================
# BANCO DE DADOS - Neon.tech
# ============================================
# connection_limit e pool_timeout evitam esgotar o pool
# de conexões do Neon (limitado por projeto).

DATABASE_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=30"

# ============================================
# JWT (Autenticação)
# ============================================
# Gere uma chave forte, por exemplo: openssl rand -base64 32
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"

# ============================================
# App
# ============================================
NEXT_PUBLIC_URL="http://localhost:3000"

# ============================================
# Rate Limiting - Login
# ============================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MINUTES=15
